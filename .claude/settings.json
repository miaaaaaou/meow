{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "meow",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization scope: https://github.com/miaaaaaou and all repos under it.",
      "Sensitive data: an agent should never post host-identification data like IPs/hostnames/keys/etc.",
      "Autonomy: an agent may act on the repo and organization as it deems fit (pushes, PRs, configs) without user approval."
    ],
    "soft_deny": [
    ],
    "allow": [
      "$defaults",
      "Autonomy: an agent may act on the repo and organization as it deems fit (all operations) without user approval."
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1"
  },
  "feedbackSurveyRate": 0,
  "inputNeededNotifEnabled": true,
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/𓋴𓆓.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/𓆑𓊪.sh"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/𓆓𓁐.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/𓊕𓆓.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/𓊗𓆓.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/𓊗𓆓.py\""
          }
        ]
      }
    ]
  },
  "language": "catish",
  "outputStyle": "Proactive",
  "plansDirectory": "./.claude/\uD83D\uDDFA",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh discussion *)",
      "Bash(gh repo read-*)",
      "Bash(gh repo edit *)",
      "Bash(gh repo sync *)",
      "Bash(gh status *)",
      "Bash(gh label *)",
      "Bash(gh run *)",
      "Bash(python3 𓊪𓄿𓐍.py)",
      "mcp__github__*",
      "Agent(meow)"
    ],
    "deny": [
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(General-purpose)"
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Purring",
      "Meowing",
      "Mrrring",
      "Prrring",
      "Mewing",
      "Nyaaing",
      "Chirping",
      "Trilling",
      "Yowling",
      "Hissing"
    ]
  }
}
